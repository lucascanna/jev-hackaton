# Server-only credentials. Copy to .env.local and fill in locally.
OPENAI_API_KEY=
JEV_API_KEY=
OPENAI_MODEL=gpt-5.3-codex
# Optional: endpoint override for local verification (never use real keys with emulators).
# OPENAI_BASE_URL=http://127.0.0.1:4100/v1
JEV_MODEL=jev-latest
# Optional API root override for Jev (defaults to https://api.typesafe.ai/v1).
# JEV_BASE_URL=https://api.typesafe.ai/v1
